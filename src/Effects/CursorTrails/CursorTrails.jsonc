{
    "effectDisplayName": "Cursor Trails",
    "disabled": false,
    "configurableProperties": [
        {
            "name": "enabled",
            "type": "boolean",
            "default": true,
            "description": "Enable or disable a trail effect that follows behind the editor cursor as it moves around.",
            "markdownDescription": "Enable or disable a trail effect that follows behind the editor cursor as it moves around."
        },
        {
            "name": "type",
            "type": "string",
            "enum": [
                "solid",
                "disconnected"
            ],
            "default": "solid",
            "description": "The type of cursor trail to use. 'solid' will create a continuous connected trail that follows your editor cursor around, while 'disconnected' will create 'trail segments' that follow your cursor around in a disconnected manner, collapsing into themselves as they expire.",
            "markdownDescription": "The type of cursor trail to use. **solid** will create a continuous connected trail that follows your editor cursor around, while **disconnected** will create *trail segments* that follow your cursor around in a disconnected manner, collapsing into themselves as they expire."   
        },
        {
            "name": "disconnectedTrailSegmentLifetime",
            "type": "number",
            "default": 750,
            "inBloomEditor": {
                "cssUnit": "ms",
                "stepSize": 25
            },
            "description": "The lifetime - in milliseconds - of each trail segment that gets left behind by the cursor as it moves.",
            "markdownDescription": "The lifetime - in **milliseconds** - of each trail segment that gets left behind by the cursor as it moves."
        },
        {
            "name": "color",
            "type": "string",
            "default": "#FFFFFFAF",
            "isColor": true,
            "description": "The color of the trail that follows behind the cursor as it moves.",
            "markdownDescription": "The color of the trail that follows behind the cursor as it moves."
        },
        {
            "name": "maxSolidTrailLength",
            "type": "number",
            "default": 100,
            "inBloomEditor": {
                "cssUnit": "px",
                "stepSize": 5
            },
            "description": "The maximum length of the trail that follows behind the cursor as it moves, in pixels.",
            "markdownDescription": "The maximum length of the trail that follows behind the cursor as it moves, in **pixels**."
        },
        {
            "name": "solidTrailWidth",
            "type": "number",
            "default": 3,
            "inBloomEditor": {
                "cssUnit": "px",
                "stepSize": 0.25
            },
            "description": "The width of the trail that follows behind the cursor as it moves, in pixels.",
            "markdownDescription": "The width of the trail that follows behind the cursor as it moves, in **pixels**."
        },
        {
            "name": "solidTrailSpeed",
            "type": "number",
            "default": 20,
            "inBloomEditor": {
                "cssUnit": "px/s",
                "stepSize": 2.5
            },
            "description": "The speed at which the trail should pursue the cursor, in pixels/second",
            "markdownDescription": "The speed at which the trail should pursue the cursor, in **pixels/second**."
        },
        {
            "name": "solidTrailCount",
            "type": "number",
            "default": 1,
            "inBloomEditor": {
                "cssUnit": "trails",
                "stepSize": 1
            },
            "description": "The amount of trails that should be created per cursor for the solid trail type.",
            "markdownDescription": "The amount of trails that should be created per cursor for the solid trail type."
        },
        {
            "name": "solidTrailMaxAngleChangePerFrame",
            "type": "number",
            "default": 10,
            "inBloomEditor": {
                "cssUnit": "deg",
                "stepSize": 1
            },
            "description": "The maximum angle - in degrees - for which solid trail's head can change per frame, whilst accelerating towards the cursor's position as it changes.",
            "markdownDescription": "The maximum angle - in **degrees** - for which solid trail's head can change per frame, whilst accelerating towards the cursor's position as it changes."
        }
    ]
}