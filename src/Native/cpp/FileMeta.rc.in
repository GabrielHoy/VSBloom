#include <Windows.h>
#include <winver.h>

1 ICON "@VSBLOOM_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VSBLOOM_VERSION_MAJOR@,@VSBLOOM_VERSION_MINOR@,@VSBLOOM_VERSION_PATCH@,@VSBLOOM_VERSION_BUILD@
 PRODUCTVERSION @VSBLOOM_VERSION_MAJOR@,@VSBLOOM_VERSION_MINOR@,@VSBLOOM_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Tampered Reality\0"
      VALUE "FileDescription", "VSBloom: Native Runtime\0"
      VALUE "FileVersion", "@VSBLOOM_VERSION_STRING@.@VSBLOOM_VERSION_BUILD@\0"
      VALUE "InternalName", "VSBloomNativeRuntime\0"
      VALUE "OriginalFilename", "VSBloomNativeRuntime.exe\0"
      VALUE "ProductName", "VSBloom Native Runtime\0"
      VALUE "ProductVersion", "@VSBLOOM_VERSION_STRING@\0"
      VALUE "LegalCopyright", "Copyright Tampered Reality @VSBLOOM_COPYRIGHT_YEAR@\0"
      VALUE "Comments", "This program is a native helper, made to supplement VSBloom's VSCode Extension functionality.\0"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END