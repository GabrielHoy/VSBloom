{
	"files": [
		"./src/EffectLib/jsonc-module.d.ts"
	],
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"types": [],
		"paths": {
            "src/*": ["./src/*"],
			"bloom": ["./src/EffectLib/Bloom/Bloom"],
			"gsap": ["./node_modules/gsap"],
			"motion": ["./node_modules/motion"],
			"pixi.js": ["./node_modules/pixi.js"]
		}
	}
}